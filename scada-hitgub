</div>

</div>


</div>


</div>

</div>


<!-- =======================================================
     MODAL CREAR CONTRASEÑA
======================================================== -->

<div
    id="modalCrear"
    class="modal">

<div class="modal-box">

<h2>
    🔐 Crear contraseña
</h2>

<p>
    Esta contraseña protegerá el acceso al modo remoto.
</p>

<input
    type="password"
    id="nuevaContrasena"
    placeholder="Nueva contraseña">


<div class="modal-buttons">

<button
    class="btn-off"
    onclick="cerrarModal('modalCrear')">

    CANCELAR

</button>


<button
    class="btn-on"
    onclick="crearContrasena()">

    CREAR

</button>

</div>

</div>

</div>


<!-- =======================================================
     MODAL ACCESO
======================================================== -->

<div
    id="modalAcceso"
    class="modal">

<div class="modal-box">

<h2>
    🔐 Autorización de operador
</h2>

<p>
    Ingresá la contraseña para habilitar el acceso remoto.
</p>

<input
    type="password"
    id="contrasena"
    placeholder="Contraseña">


<div class="modal-buttons">

<button
    class="btn-off"
    onclick="cerrarModal('modalAcceso')">

    CANCELAR

</button>


<button
    class="btn-on"
    onclick="autorizar()">

    INGRESAR

</button>

</div>

</div>

</div>


<script>

/* =========================================================
   VARIABLES
========================================================= */

let accesoAutorizado = false;

let modoForzado = false;


/* =========================================================
   MODALES
========================================================= */

function abrirModal(id) {

    document.getElementById(id).style.display = "flex";

}


function cerrarModal(id) {

    document.getElementById(id).style.display = "none";

}


/* =========================================================
   SEGURIDAD
========================================================= */

function actualizarInterfazSeguridad() {

    const candado =
        document.getElementById("candado");

    const texto =
        document.getElementById("estadoSeguridad");

    const boton =
        document.getElementById("btnCandado");


    if (accesoAutorizado) {

        candado.innerHTML = "🔓";

        texto.innerHTML =
            "ACCESO AUTORIZADO";

        texto.className =
            "security-state security-open";

        boton.innerHTML =
            "BLOQUEAR";

    }

    else {

        candado.innerHTML = "🔒";

        texto.innerHTML =
            "ACCESO BLOQUEADO";

        texto.className =
            "security-state security-locked";

        boton.innerHTML =
            "AUTORIZAR";

    }

}


/* =========================================================
   CANDADO
========================================================= */

async function gestionarCandado() {

    const respuesta =
        await fetch("/datos");

    const datos =
        await respuesta.json();


    if (!datos.contrasena_creada) {

        abrirModal("modalCrear");

        return;

    }


    if (!datos.acceso_autorizado) {

        abrirModal("modalAcceso");

        return;

    }


    await fetch(
        "/cerrar_acceso",
        {
            method: "POST"
        }
    );


    accesoAutorizado = false;

    modoForzado = false;

    actualizarInterfazSeguridad();

    actualizarDatos();

}


/* =========================================================
   CREAR CONTRASEÑA
========================================================= */

async function crearContrasena() {

    const password =
        document.getElementById(
            "nuevaContrasena"
        ).value;


    if (password.length < 4) {

        alert(
            "La contraseña debe tener al menos 4 caracteres."
        );

        return;

    }


    const respuesta =
        await fetch(
            "/crear_contrasena",
            {
                method: "POST",

                headers: {
                    "Content-Type":
                        "application/json"
                },

                body: JSON.stringify({
                    contrasena: password
                })

            }
        );


    const datos =
        await respuesta.json();


    if (datos.ok) {

        alert(
            "Contraseña creada correctamente."
        );

        cerrarModal("modalCrear");

        document.getElementById(
            "nuevaContrasena"
        ).value = "";

    }

    else {

        alert(datos.mensaje);

    }

}


/* =========================================================
   AUTORIZAR
========================================================= */

async function autorizar() {

    const password =
        document.getElementById(
            "contrasena"
        ).value;


    if (!password) {

        alert(
            "Ingresá la contraseña."
        );

        return;

    }


    const respuesta =
        await fetch(
            "/autorizar",
            {
                method: "POST",

                headers: {
                    "Content-Type":
                        "application/json"
                },

                body: JSON.stringify({
                    contrasena: password
                })

            }
        );


    const datos =
        await respuesta.json();


    if (datos.ok) {

        accesoAutorizado = true;

        cerrarModal("modalAcceso");

        document.getElementById(
            "contrasena"
        ).value = "";

        actualizarInterfazSeguridad();

        await actualizarDatos();

        alert(
            "Acceso autorizado."
        );

    }

    else {

        alert(datos.mensaje);

    }

}


/* =========================================================
   CAMBIAR MODO
========================================================= */

async function cambiarModo(remoto) {

    if (
        remoto &&
        !accesoAutorizado
    ) {

        abrirModal("modalAcceso");

        return;

    }


    const respuesta =
        await fetch(
            "/modo",
            {
                method: "POST",

                headers: {
                    "Content-Type":
                        "application/json"
                },

                body: JSON.stringify({
                    modo: remoto
                })

            }
        );


    const datos =
        await respuesta.json();


    if (!datos.ok) {

        alert(datos.mensaje);

        return;

    }


    modoForzado = remoto;


    if (!remoto) {

        accesoAutorizado = false;

        actualizarInterfazSeguridad();

    }


    await actualizarDatos();

}


/* =========================================================
   CONTROL SERVO
========================================================= */

async function controlServo(encender) {

    if (
        !accesoAutorizado ||
        !modoForzado
    ) {

        alert(
            "Debe estar autorizado y en modo REMOTO."
        );

        return;

    }


    const respuesta =
        await fetch(
            "/control_servo",
            {
                method: "POST",

                headers: {
                    "Content-Type":
                        "application/json"
                },

                body: JSON.stringify({
                    estado: encender
                })

            }
        );


    const datos =
        await respuesta.json();


    if (!datos.ok) {

        alert(datos.mensaje);

    }


    await actualizarDatos();

}


/* =========================================================
   CONTROL LED
========================================================= */

async function controlLed(encender) {

    if (
        !accesoAutorizado ||
        !modoForzado
    ) {

        alert(
            "Debe estar autorizado y en modo REMOTO."
        );

        return;

    }


    const respuesta =
        await fetch(
            "/control_led",
            {
                method: "POST",

                headers: {
                    "Content-Type":
                        "application/json"
                },

                body: JSON.stringify({
                    estado: encender
                })

            }
        );


    const datos =
        await respuesta.json();


    if (!datos.ok) {

        alert(datos.mensaje);

    }


    await actualizarDatos();

}


/* =========================================================
   ACTUALIZAR DATOS
========================================================= */

async function actualizarDatos() {

    try {

        const respuesta =
            await fetch("/datos");


        const datos =
            await respuesta.json();


        /* COMUNICACIÓN */

        const arduino =
            document.getElementById(
                "arduinoEstado"
            );

        const light =
            document.getElementById(
                "arduinoLight"
            );

        const dot =
            document.getElementById(
                "statusDot"
            );

        const top =
            document.getElementById(
                "topStatus"
            );


        if (datos.arduino_conectado) {

            arduino.innerHTML =
                "CONECTADO";

            arduino.style.color =
                "#00e676";

            light.className =
                "light green";

            dot.className =
                "status-dot online";

            top.innerHTML =
                "SISTEMA ONLINE";

        }

        else {

            arduino.innerHTML =
                "DESCONECTADO";

            arduino.style.color =
                "#ff5252";

            light.className =
                "light red";

            dot.className =
                "status-dot";

            top.innerHTML =
                "SISTEMA DESCONECTADO";

        }


        /* SERVO */

        const servo =
            document.getElementById(
                "estadoServo"
            );

        const processServo =
            document.getElementById(
                "processServo"
            );


        if (datos.estado_servo) {

            servo.innerHTML =
                "ENCENDIDO";

            servo.style.color =
                "#00e676";

            processServo.innerHTML =
                "ENCENDIDO";

            processServo.style.color =
                "#00e676";

        }

        else {

            servo.innerHTML =
                "APAGADO";

            servo.style.color =
                "#78909c";

            processServo.innerHTML =
                "APAGADO";

            processServo.style.color =
                "#78909c";

        }


        /* LED */

        const led =
            document.getElementById(
                "estadoLed"
            );

        const processLed =
            document.getElementById(
                "processLed"
            );


        if (datos.estado_led) {

            led.innerHTML =
                "ENCENDIDO";

            led.style.color =
                "#00e676";

            processLed.innerHTML =
                "ENCENDIDO";

            processLed.style.color =
                "#00e676";

        }

        else {

            led.innerHTML =
                "APAGADO";

            led.style.color =
                "#78909c";

            processLed.innerHTML =
                "APAGADO";

            processLed.style.color =
                "#78909c";

        }


        /* SEGURIDAD */

        accesoAutorizado =
            datos.acceso_autorizado;

        modoForzado =
            datos.modo_forzado;


        actualizarInterfazSeguridad();


        /* MODO */

        const modo =
            document.getElementById(
                "modoActual"
            );


        if (modoForzado) {

            modo.innerHTML =
                "REMOTO";

            modo.className =
                "mode-value mode-remote";

        }

        else {

            modo.innerHTML =
                "LOCAL";

            modo.className =
                "mode-value mode-local";

        }


        document.getElementById(
            "btnRemoto"
        ).disabled =
            !accesoAutorizado;


        document.getElementById(
            "btnLocal"
        ).disabled =
            !accesoAutorizado;


        /* ACTUADORES */

        const puedeControlar =
            accesoAutorizado &&
            modoForzado &&
            datos.arduino_conectado;


        document.getElementById(
            "servoOn"
        ).disabled =
            !puedeControlar;


        document.getElementById(
            "servoOff"
        ).disabled =
            !puedeControlar;


        document.getElementById(
            "ledOn"
        ).disabled =
            !puedeControlar;


        document.getElementById(
            "ledOff"
        ).disabled =
            !puedeControlar;


        /* IA */

        if (datos.analisis_ia) {

            const ia =
                datos.analisis_ia;


            document.getElementById(
                "iaEstado"
            ).innerHTML =
                ia.estado || "---";


            document.getElementById(
                "iaRiesgo"
            ).innerHTML =
                ia.riesgo || "---";


            document.getElementById(
                "iaTendencia"
            ).innerHTML =
                ia.tendencia || "---";


            document.getElementById(
                "iaDiagnostico"
            ).innerHTML =
                ia.diagnostico ||
                "Sin diagnóstico.";


            document.getElementById(
                "iaRecomendacion"
            ).innerHTML =
                ia.recomendacion ||
                "Sin recomendaciones.";


            document.getElementById(
                "ciclos"
            ).innerHTML =
                ia.ciclos || 0;


            document.getElementById(
                "promedio"
            ).innerHTML =
                (ia.promedio || 0) +
                " s";


            document.getElementById(
                "ultimoCiclo"
            ).innerHTML =
                (ia.ultimo_ciclo || 0) +
                " s";


            /* ALARMA */

            const alarm =
                document.getElementById(
                    "alarmBox"
                );

            const alarmText =
                document.getElementById(
                    "alarmText"
                );


            if (
                ia.anomalia === true
            ) {

                alarm.className =
                    "alarm danger";

                alarmText.innerHTML =
                    "Anomalía detectada por el sistema IA.";

            }

            else {

                alarm.className =
                    "alarm";

                alarmText.innerHTML =
                    "Sin alarmas activas.";

            }

        }


        cargarHistorial();

    }

    catch(error) {

        console.error(
            "Error actualizando SCADA:",
            error
        );

    }

}


/* =========================================================
   HISTORIAL
========================================================= */

async function cargarHistorial() {

    try {

        const respuesta =
            await fetch(
                "/historial"
            );


        const datos =
            await respuesta.json();


        const tbody =
            document.getElementById(
                "historialBody"
            );


        tbody.innerHTML = "";


        datos.forEach(
            registro => {

                const fila =
                    document.createElement(
                        "tr"
                    );


                fila.innerHTML = `

                    <td>
                        ${registro.fecha || ""}
                    </td>

                    <td>
                        ${registro.hora || ""}
                    </td>

                    <td>
                        ${registro.equipo || ""}
                    </td>

                    <td>
                        ${registro.evento || ""}
                    </td>

                    <td>
                        ${registro.duracion || ""}
                    </td>

                    <td>
                        ${registro.modo || ""}
                    </td>

                `;


                tbody.appendChild(
                    fila
                );

            }
        );

    }

    catch(error) {

        console.error(
            "Error historial:",
            error
        );

    }

}


/* =========================================================
   CHAT IA
========================================================= */

async function preguntarIA() {

    const input =
        document.getElementById(
            "pregunta"
        );


    const pregunta =
        input.value.trim();


    if (!pregunta) {

        return;

    }


    const chat =
        document.getElementById(
            "chatBox"
        );


    /* USUARIO */

    const usuario =
        document.createElement(
            "div"
        );


    usuario.className =
        "message user";


    usuario.innerHTML =
        pregunta;


    chat.appendChild(
        usuario
    );


    input.value = "";


    try {

        const respuesta =
            await fetch(
                "/preguntar_ia",
                {
                    method: "POST",

                    headers: {
                        "Content-Type":
                            "application/json"
                    },

                    body: JSON.stringify({
                        pregunta: pregunta
                    })

                }
            );


        const datos =
            await respuesta.json();


        const ia =
            document.createElement(
                "div"
            );


        ia.className =
            "message ai";


        ia.innerHTML =
            datos.respuesta ||
            "No se recibió respuesta.";


        chat.appendChild(
            ia
        );


        chat.scrollTop =
            chat.scrollHeight;

    }

    catch(error) {

        console.error(error);

        const ia =
            document.createElement(
                "div"
            );


        ia.className =
            "message ai";


        ia.innerHTML =
            "Error comunicando con el sistema IA.";


        chat.appendChild(
            ia
        );

    }

}


/* =========================================================
   INICIO
========================================================= */

actualizarDatos();


setInterval(
    actualizarDatos,
    1000
);

</script>

</body>

</html>

