<!-- IA -->

<div class="panel">

<div class="panel-header">

    ANÁLISIS INTELIGENTE

    <span class="panel-code">
        IA-01
    </span>

</div>


<div class="panel-body">


<div class="ai-status">


<div class="ai-row">

<span>
    Estado
</span>

<span
    id="iaEstado"
    class="ai-value">

    ---

</span>

</div>


<div class="ai-row">

<span>
    Riesgo
</span>

<span
    id="iaRiesgo"
    class="ai-value">

    ---

</span>

</div>


<div class="ai-row">

<span>
    Tendencia
</span>

<span
    id="iaTendencia"
    class="ai-value">

    ---

</span>

</div>

</div>


<div class="ai-diagnosis">

