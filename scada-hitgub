<!-- CHAT IA -->

<div class="panel">

<div class="panel-header">

    ASISTENTE IA

    <span class="panel-code">
        IA-02
    </span>

</div>


<div class="panel-body">


<div
    id="chatBox"
    class="chat">

<div class="message ai">

🤖 Sistema IA iniciado.<br>
Podés consultar información sobre el proceso, estados, ciclos, tiempos y funcionamiento del sistema.

</div>

</div>


<div class="chat-input">

<input
    type="text"
    id="pregunta"
    placeholder="Escribí una pregunta..."
    onkeydown="if(event.key==='Enter') preguntarIA()">


<button
    class="btn-send"
    onclick="preguntarIA()">

    ENVIAR

</button>

